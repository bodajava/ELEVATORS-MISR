# Egypt Elevators — environment template.
#
# Copy to `.env.local` and fill in. Never commit a filled-in copy: `.gitignore` tracks
# `.env.example` alone and ignores every other `.env*`. Placeholders below are shaped like
# the real thing but are not real credentials.
#
# Every variable is read through `src/lib/env.ts`, which validates it at first use on the
# server. Nothing here except NEXT_PUBLIC_* is ever exposed to the browser.

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Used for canonical URLs, hreflang, sitemap,
# Open Graph and JSON-LD @id values. Public by design (it is in the HTML already).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (PostgreSQL, provider-neutral) ──────────────────────────────────
# Any PostgreSQL 14+ works: local, Neon, Supabase, RDS, Cloud SQL, self-hosted. No
# provider SDK is used — just the `postgres` driver over a standard connection string.
#
# DATABASE_URL  runtime connection. Use the POOLED endpoint if your provider has one.
# DIRECT_URL    optional; a non-pooled connection for `drizzle-kit` migrations. Providers
#               that pool through PgBouncer in transaction mode cannot run DDL over the
#               pooled URL. Leave blank when there is no separate endpoint — migrations
#               then use DATABASE_URL.
#
# Add `?sslmode=require` for any managed provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=
#
# Supabase specifically: its "direct connection" host (db.<ref>.supabase.co) resolves over
# IPv6 only, which a plain IPv4 network cannot reach — `getaddrinfo ENOTFOUND` from
# `drizzle-kit migrate` on a network without IPv6 egress is this, not a bad URL. Use the
# **Session pooler** for DIRECT_URL instead: same pooler host as DATABASE_URL, port 5432
# instead of the Transaction pooler's 6543. Session mode holds one real connection per
# client rather than multiplexing per-transaction, so unlike the transaction pooler it can
# run DDL, and it is IPv4-reachable. Both connection strings are on the project's Database
# Settings → Connection string page in the Supabase dashboard.

# ── Abuse protection ─────────────────────────────────────────────────────────
# Secret used to hash client IPs before they are used as rate-limit keys, so no raw IP is
# ever held in memory or written anywhere. Any long random string; rotating it resets the
# in-flight rate-limit windows and nothing else.
#   openssl rand -base64 32
RATE_LIMIT_SALT=

# ── Lead notification (optional) ──────────────────────────────────────────────
# When a site inspection request or a concierge handoff is saved, a bilingual HTML email goes
# to LEAD_NOTIFICATION_EMAIL via Gmail SMTP (Nodemailer) — see src/lib/email/lead-notification.ts
# and lead-notification-template.ts. All three or none: leave blank to skip sending entirely
# (the visitor-facing submission path is unaffected either way; leads are still recorded in
# the database).
#
# GMAIL_USER          the sending Gmail address. Also used as the message's From address —
#                      Gmail's SMTP servers reject a From that is not the authenticated
#                      account (or one of its "Send As" aliases), so there is no separate
#                      from-address variable the way a domain-verified provider would need.
# GMAIL_APP_PASSWORD   a 16-character App Password, NOT the account's login password. Requires
#                      2-Step Verification enabled on the account. Generate one at
#                      myaccount.google.com → Security → 2-Step Verification → App passwords.
# LEAD_NOTIFICATION_EMAIL   the inbox that should receive new-lead emails. Can be the same
#                           address as GMAIL_USER, or a different one the team actually reads.
GMAIL_USER=
GMAIL_APP_PASSWORD=
LEAD_NOTIFICATION_EMAIL=

# ── Distributed rate limiting (optional) ──────────────────────────────────────
# Without these, rate limiting (the inspection form and the concierge route share one
# limiter) runs as a fixed-window counter in process memory — correct for a single instance,
# but each instance of a multi-instance deployment gets its own budget rather than sharing
# one. Configuring Upstash makes every instance share the same counters; see
# src/lib/inspection/rate-limit.ts and src/instrumentation.ts, which installs the swap.
#
# These are the REST API credentials specifically, not the `redis://` connection string —
# the app uses Upstash's HTTPS/fetch client (`@upstash/redis`), never a TCP client, because a
# serverless function cannot hold the persistent socket a TCP client needs. Find both on the
# database's page in the Upstash console, under "REST API" — not under "Connect".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── AI concierge (optional) ──────────────────────────────────────────────────
# The assistant answers questions about panorama elevators, the process, and navigating the
# site. It is entirely optional: with no key the site builds and runs, and the concierge shows
# a plain "not available" message. It never falls back to scripted replies.
#
# Set ONE provider key. CONCIERGE_PROVIDER is only needed if more than one is present —
# with a single key set, the provider is inferred automatically.
#   anthropic | openai | google
CONCIERGE_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# aistudio.google.com/apikey — the variable name is the AI SDK's own default for this
# provider, so it needs no explicit `apiKey` wiring beyond what's already in provider.ts.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model override. Defaults: claude-sonnet-4-5 / gpt-4.1-mini / gemini-flash-latest
CONCIERGE_MODEL=
